# Copy to .env and adjust. `npm run db:start` provisions a local Postgres
# cluster matching whatever DATABASE_URL says.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/hr_ecosystem"

# Auth.js. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"

# File storage. STORAGE_DRIVER=local writes under .storage/ (development only).
# Set STORAGE_DRIVER=s3 plus the S3_* values for any real deployment.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Email. EMAIL_DRIVER=console logs invite/reset links to the server console.
# Set EMAIL_DRIVER=resend and RESEND_API_KEY to actually deliver mail.
EMAIL_DRIVER="console"
EMAIL_FROM="HR Platform <no-reply@example.com>"
# RESEND_API_KEY=""

# Max upload size for employee documents, in bytes (default 10 MB).
MAX_UPLOAD_BYTES="10485760"
