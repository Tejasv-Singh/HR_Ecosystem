// HR Platform — core data model (Phase 1).
//
// Every tenant-owned table carries `tenantId`. Nothing in the application layer
// is allowed to query these tables without scoping by it; see lib/permissions.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

/// An employing organization. The multi-tenant root.
model Tenant {
  id          String   @id @default(cuid())
  name        String
  countryCode String   @default("US") // for future localization
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  employees          Employee[]
  departments        Department[]
  documents          Document[]
  documentCategories DocumentCategory[]
  employmentTypes    EmploymentType[]
  invites            Invite[]
  auditLogs          AuditLog[]
  leaveTypes         LeaveType[]
  leaveRequests      LeaveRequest[]
  leaveLedger        LeaveLedgerEntry[]
  holidays           Holiday[]
  timeEntries        TimeEntry[]
  timesheets         Timesheet[]

  /// Contracted full-time week. Anything beyond this on an approved timesheet is overtime.
  standardWeeklyHours Decimal @default(40) @db.Decimal(5, 2)
}

enum Role {
  SUPER_ADMIN // platform-level
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  PENDING // invited, has not set a password yet
  ACTIVE
  DISABLED
}

/// A login account. Scoped to exactly one tenant.
model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String     @unique
  passwordHash String? // null while an invite is pending, or when using SSO
  role         Role       @default(EMPLOYEE)
  status       UserStatus @default(PENDING)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee?
  passwordResets PasswordResetToken[]

  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// An invitation for a person to claim the login attached to their Employee record.
model Invite {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  invitedBy  String
  createdAt  DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  ONBOARDING
  ON_LEAVE
  OFFBOARDING
  TERMINATED
}

model Employee {
  id               String         @id @default(cuid())
  tenantId         String
  userId           String?        @unique // link to login (may be a pending invite)
  employeeNumber   String?
  firstName        String
  lastName         String
  preferredName    String?
  workEmail        String
  personalEmail    String?
  phone            String?
  jobTitle         String?
  departmentId     String?
  managerId        String? // self-relation -> org chart
  employmentTypeId String?
  status           EmployeeStatus @default(ACTIVE)
  startDate        DateTime?
  endDate          DateTime?
  location         String?
  dateOfBirth      DateTime?
  address          String?
  bio              String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  department        Department?        @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  employmentType    EmploymentType?    @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  manager           Employee?          @relation("ReportingLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports           Employee[]         @relation("ReportingLine")
  leadsDepartments  Department[]       @relation("DepartmentLead")
  documents         Document[]
  emergencyContacts EmergencyContact[]
  leaveRequests     LeaveRequest[]     @relation("LeaveRequester")
  leaveDecisions    LeaveRequest[]     @relation("LeaveDecider")
  leaveLedger       LeaveLedgerEntry[]
  timeEntries       TimeEntry[]
  timesheets        Timesheet[]        @relation("TimesheetOwner")
  timesheetDecisions Timesheet[]       @relation("TimesheetDecider")
  invites           Invite[]

  @@unique([tenantId, workEmail])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([departmentId])
  @@index([managerId])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  tenantId     String
  employeeId   String
  name         String
  relationship String?
  phone        String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  parentId  String? // nested departments
  leadId    String? // an Employee
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")
  lead     Employee?    @relation("DepartmentLead", fields: [leadId], references: [id], onDelete: SetNull)
  members  Employee[]   @relation("DepartmentMembers")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Configuration (config over hardcode)
// ---------------------------------------------------------------------------

model EmploymentType {
  id       String  @id @default(cuid())
  tenantId String
  name     String // Full-time, Part-time, Contractor, Intern...
  isActive Boolean @default(true)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model DocumentCategory {
  id             String  @id @default(cuid())
  tenantId       String
  name           String // Contract, ID, Certification...
  requiresExpiry Boolean @default(false)
  isActive       Boolean @default(true)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  categoryId String
  fileKey    String // storage reference
  fileName   String
  mimeType   String    @default("application/octet-stream")
  sizeBytes  Int       @default(0)
  expiresAt  DateTime? // drives the expiring-documents list
  uploadedBy String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category DocumentCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, expiresAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String // User id of whoever performed the action
  actorEmail String?
  action     String // CREATE / UPDATE / DELETE / LOGIN / ...
  entityType String
  entityId   String
  summary    String?
  changes    Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// Leave (Phase 2)
//
// Balances are never stored as a mutable number. Every grant, accrual, booking
// and refund is a row in LeaveLedgerEntry, and a balance is the sum of that
// employee's rows for a type and year. It costs one aggregate query and buys an
// answer to "why is my balance 12.5?" that survives audit.
// ---------------------------------------------------------------------------

/// How an employee's yearly entitlement appears in the ledger.
enum AccrualMethod {
  NONE // no automatic entitlement; balances come from manual adjustments
  ANNUAL_GRANT // the whole allowance lands on 1 January (pro-rated on join)
  MONTHLY_ACCRUAL // 1/12 of the allowance per completed month
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Why a ledger row exists. Signed days: grants are positive, bookings negative.
enum LeaveLedgerReason {
  GRANT
  ACCRUAL
  CARRY_OVER
  TAKEN
  REFUND
  ADJUSTMENT
}

/// A configurable kind of leave — annual, sick, unpaid... (spec §1: config over hardcode).
model LeaveType {
  id                String        @id @default(cuid())
  tenantId          String
  name              String
  colour            String        @default("#64748b") // calendar/badge tint
  isPaid            Boolean       @default(true)
  requiresApproval  Boolean       @default(true)
  allowsHalfDay     Boolean       @default(true)
  /// Whether a booking may push the balance below zero.
  allowsNegative    Boolean       @default(false)
  accrualMethod     AccrualMethod @default(ANNUAL_GRANT)
  annualDays        Decimal       @default(0) @db.Decimal(6, 2)
  /// Unused days that may roll into next year. Null means "no carry-over".
  carryOverMaxDays  Decimal?      @db.Decimal(6, 2)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]
  ledger   LeaveLedgerEntry[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// A non-working day for the whole tenant. Excluded from leave day counts.
model Holiday {
  id       String   @id @default(cuid())
  tenantId String
  name     String
  date     DateTime @db.Date

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

model LeaveRequest {
  id          String             @id @default(cuid())
  tenantId    String
  employeeId  String
  leaveTypeId String
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  /// Half-day markers. A one-day afternoon-only request sets both.
  startHalf   Boolean            @default(false)
  endHalf     Boolean            @default(false)
  /// Working days requested, computed at submission and frozen thereafter.
  days        Decimal            @db.Decimal(6, 2)
  reason      String?
  status      LeaveRequestStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  decisionNote String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee           @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy Employee?          @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  leaveType LeaveType          @relation(fields: [leaveTypeId], references: [id])
  ledger    LeaveLedgerEntry[]

  @@index([tenantId, status])
  @@index([employeeId, startDate])
  @@index([tenantId, startDate, endDate])
}

model LeaveLedgerEntry {
  id          String            @id @default(cuid())
  tenantId    String
  employeeId  String
  leaveTypeId String
  /// Leave year this row belongs to. Balances are always per-year.
  year        Int
  /// Signed: positive adds entitlement, negative consumes it.
  days        Decimal           @db.Decimal(6, 2)
  reason      LeaveLedgerReason
  requestId   String?
  note        String?
  createdById String? // User id, null for system-generated accrual
  createdAt   DateTime          @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType     @relation(fields: [leaveTypeId], references: [id])
  request   LeaveRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId, leaveTypeId, year])
  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Time & attendance (Phase 2)
//
// Hours are recorded as individual entries and rolled up into a weekly
// Timesheet that gets submitted and approved as one unit. Approving a week
// freezes its total, so a later edit to an entry cannot quietly change hours
// that payroll has already seen.
// ---------------------------------------------------------------------------

enum TimeEntrySource {
  CLOCK // started and stopped with the in-app timer
  MANUAL // typed in after the fact
}

enum TimesheetStatus {
  OPEN // still being filled in
  SUBMITTED // awaiting a decision
  APPROVED
  REJECTED // sent back for correction
}

/// One worked interval on one day.
model TimeEntry {
  id          String          @id @default(cuid())
  tenantId    String
  employeeId  String
  /// The day the work is booked against, in tenant-local reckoning.
  workDate    DateTime        @db.Date
  startedAt   DateTime
  /// Null while a clock-in is still running.
  endedAt     DateTime?
  /// Frozen on close so a timesheet total never depends on re-deriving it.
  minutes     Int             @default(0)
  note        String?
  source      TimeEntrySource @default(MANUAL)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId, workDate])
  // Finding someone's running clock has to be cheap; it happens on every page load.
  @@index([employeeId, endedAt])
}

/// A week of time entries, submitted and approved as one unit.
model Timesheet {
  id           String          @id @default(cuid())
  tenantId     String
  employeeId   String
  /// Always a Monday. One row per employee per week.
  weekStart    DateTime        @db.Date
  status       TimesheetStatus @default(OPEN)
  /// Minutes at the moment of approval. Null until then.
  totalMinutes Int?
  submittedAt  DateTime?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee  @relation("TimesheetOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy Employee? @relation("TimesheetDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, weekStart])
  @@index([tenantId, status])
  @@index([tenantId, weekStart])
}
